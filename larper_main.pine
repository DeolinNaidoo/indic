// ════════════════════════════════════════════════════════════════════════════════════
// ADVANCED CYCLE FILTERING SYSTEM (Larper Suite)
// ════════════════════════════════════════════════════════════════════════════════════
type CycleFilter
    bool    enabled
    bool    showAllTime
    bool    useYearly
    bool    useMonthly
    bool    useWeekly
    bool    useDaily
    bool    use90m
    bool    useMicro
    bool    q1
    bool    q2
    bool    q3
    bool    q4
    bool    useNY
    bool    useLDN
    bool    useAsia
    bool    useTFFilter
    int     minTFMinutes
    int     maxTFMinutes

checkQuarter(int qVal, bool allowQ1, bool allowQ2, bool allowQ3, bool allowQ4) =>
    qVal == 1 ? allowQ1 : qVal == 2 ? allowQ2 : qVal == 3 ? allowQ3 : qVal == 4 ? allowQ4 : false

passesFilter(CycleFilter f, int yQ, int mQ, int wQ, int dQ, int q90Q, int micQ, bool inNY, bool inLDN, bool inAsia, int currentTFMinutes) =>
    if not f.enabled or f.showAllTime
        true
    else
        bool anyCycleSelected = f.useYearly or f.useMonthly or f.useWeekly or f.useDaily or f.use90m or f.useMicro
        bool cyclePass = anyCycleSelected ? (
            (not f.useYearly or checkQuarter(yQ, f.q1, f.q2, f.q3, f.q4)) and
            (not f.useMonthly or checkQuarter(mQ, f.q1, f.q2, f.q3, f.q4)) and
            (not f.useWeekly or checkQuarter(wQ, f.q1, f.q2, f.q3, f.q4)) and
            (not f.useDaily or checkQuarter(dQ, f.q1, f.q2, f.q3, f.q4)) and
            (not f.use90m or checkQuarter(q90Q, f.q1, f.q2, f.q3, f.q4)) and
            (not f.useMicro or checkQuarter(micQ, f.q1, f.q2, f.q3, f.q4))
        ) : false
        
        bool anySessionSelected = f.useNY or f.useLDN or f.useAsia
        bool sessionPass = anySessionSelected ? ((f.useNY and inNY) or (f.useLDN and inLDN) or (f.useAsia and inAsia)) : false
        
        bool tfPass = not f.useTFFilter or (currentTFMinutes >= f.minTFMinutes and currentTFMinutes <= f.maxTFMinutes)
        
        cyclePass and sessionPass and tfPass

grpPSPFlt = "─── PSP Filter Details ───"
pspFilt = CycleFilter.new(
     pspFilterEnable,
     input.bool(false, "Bypass", group=grpPSPFlt, tooltip="If true, ignores cycles/sessions and shows all signals"),
     input.bool(false, "YC",  group=grpPSPFlt, inline="pspC", tooltip="Yearly Cycle"),
     input.bool(false, "MC",  group=grpPSPFlt, inline="pspC", tooltip="Monthly Cycle"),
     input.bool(false, "WC",  group=grpPSPFlt, inline="pspC", tooltip="Weekly Cycle"),
     input.bool(false, "DC",  group=grpPSPFlt, inline="pspC", tooltip="Daily Cycle (6hr blocks)"),
     input.bool(false, "QC",  group=grpPSPFlt, inline="pspC", tooltip="90-Min Quarter Cycle"),
     input.bool(true,  "MIC", group=grpPSPFlt, inline="pspC", tooltip="Micro Cycle (22.5m)"),
     input.bool(false, "Q1", group=grpPSPFlt, inline="pspQ", tooltip="Accumulation"),
     input.bool(true,  "Q2", group=grpPSPFlt, inline="pspQ", tooltip="Manipulation"),
     input.bool(true,  "Q3", group=grpPSPFlt, inline="pspQ", tooltip="Distribution"),
     input.bool(true,  "Q4", group=grpPSPFlt, inline="pspQ", tooltip="Reversal/Continuation"),
     input.bool(true,  "NY",   group=grpPSPFlt, inline="pspS", tooltip="New York session"),
     input.bool(false, "LDN",  group=grpPSPFlt, inline="pspS", tooltip="London session"),
     input.bool(false, "Asia", group=grpPSPFlt, inline="pspS", tooltip="Asian session"),
     input.bool(true, "TF", group=grpPSPFlt, inline="pspTF", tooltip="Restrict to specific timeframes"),
     tfToMinutes(input.timeframe("1",  "", group=grpPSPFlt, inline="pspTF")),
     tfToMinutes(input.timeframe("15", "", group=grpPSPFlt, inline="pspTF"))
 )

