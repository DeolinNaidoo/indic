//@version=6
indicator("Larper Suite", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500, max_bars_back=5000)

//#region[Helper Functions]
smtCleanSym(sym) =>
    s = str.tostring(sym)
    pos = str.pos(s, ":")
    r = pos >= 0 ? str.substring(s, pos + 1) : s
    str.replace_all(str.replace_all(str.replace_all(r, "1!", ""), "USD", ""), ".USD", "")

smtGetLineSty(style) =>
    switch style
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted

smtGetLblSz(sz) =>
    switch sz
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal

getShortName(string sym) =>
    parts = str.split(sym, ":")
    parts.size() > 0 ? parts.get(parts.size() - 1) : sym

tfToMinutes(string tf) =>
    switch tf
        "1"    => 1
        "3"    => 3
        "5"    => 5
        "15"   => 15
        "30"   => 30
        "60"   => 60
        "120"  => 120
        "240"  => 240
        "D"    => 1440
        "W"    => 10080
        "M"    => 43200
        => 0

// True Opens Time Helper
f_isStart(string sessStr) =>
    t = time(timeframe.period, sessStr, "America/New_York")
    not na(t) and na(t[1])
//#endregion

