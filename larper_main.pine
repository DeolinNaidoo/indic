// ═══════════════════════════════════════════════════════════════════════════════════
// TYPES & STATE VARIABLES (SSMT)
// ═══════════════════════════════════════════════════════════════════════════════════
type SsmtEvent
    float  price1
    float  price2
    int    time1
    int    time2
    string asset_name
    string cycle
    string ev_type
    bool   is_hidden
    bool   is_bear
    line   ln
    label  lbl
    bool   active
    float  anchor_price
    string base_key
    int    confluence
    int    quarter_val
    string current_txt
    int    master_idx
    string cycle_id
    bool cisd_queued

type StrucPivot
    int bar_idx
    float body_price
    string tag

type CycleState
    float hmax
    float lmin
    float hmax1
    float lmin1
    int   hmaxt
    int   lmint
    int   hmaxt1
    int   lmint1
    float close_max
    float close_min
    float open_max
    float open_min
    float close_max1
    float close_min1
    float open_max1
    float open_min1
    int   close_maxt
    int   close_mint
    int   close_maxt1
    int   close_mint1
    float prev_q_range
    int   prev_val_ses

type StreamState
    bool bear_fired
    bool bull_fired
    array<line>       beh_lines
    array<label>      beh_labels
    array<line>       bul_lines
    array<label>      bul_labels
    array<SsmtEvent>  beh_events
    array<SsmtEvent>  bul_events

type ChartQuarterTracker
    float hmax
    float lmin
    int   prev_quarter

// ═══════════════════════════════════════════════════════════════════════════════════
// SIGNAL HISTORY TRACKING FOR SSMT ALIGNMENT
// ═══════════════════════════════════════════════════════════════════════════════════
type SignalHistory
    float price
    int   bar_index
    int   time_val
    bool  is_bull
    bool  is_sd       // true = SD, false = PSP

var array<SignalHistory> signal_history = array.new<SignalHistory>()

var array<SsmtEvent> all_events = array.new<SsmtEvent>()
var array<int> active_count = array.new<int>(1)

var array<StrucPivot> struc_pivots = array.new<StrucPivot>()

var map<string, CycleState>  main_state_map  = map.new<string, CycleState>()
var map<string, StreamState> ssmt_state_map  = map.new<string, StreamState>()
var map<string, StreamState> hssmt_state_map = map.new<string, StreamState>()
var map<string, StreamState> issmt_state_map = map.new<string, StreamState>()
var map<string, bool> active_ssmt_bear = map.new<string, bool>()
var map<string, bool> active_ssmt_bull = map.new<string, bool>()
var map<string, float> active_ssmt_bear_price = map.new<string, float>()
