// SESSION & CYCLE DETECTION (Shared)
inNYSession   = not na(time(timeframe.period, sessNYTime))
inLDNSession  = not na(time(timeframe.period, sessLDNTime))
inAsiaSession = not na(time(timeframe.period, sessAsiaTime))
currentTFMinutes = timeframe.in_seconds() / 60

nyTZ = "America/New_York"
nyHour      = hour(time, nyTZ)
nyMinute    = minute(time, nyTZ)
nyDayOfWeek = dayofweek(time, nyTZ)
nyDay       = dayofmonth(time, nyTZ)
nyMonth     = month(time, nyTZ)

yearlyQ = nyMonth <= 3 ? 1 : nyMonth <= 6 ? 2 : nyMonth <= 9 ? 3 : 4
monthlyQ = nyDay <= 7 ? 1 : nyDay <= 15 ? 2 : nyDay <= 22 ? 3 : 4

weeklyQ = switch nyDayOfWeek
    2 => 1
    3 => 2
    4 => 3
    5 => 4
    => 0

dailyQ = math.floor(nyHour / 6) + 1
minutesInto6HBlock = (nyHour % 6) * 60 + nyMinute
q90Q = minutesInto6HBlock < 90 ? 1 : minutesInto6HBlock < 180 ? 2 : minutesInto6HBlock < 270 ? 3 : 4
minutesInto90Block = minutesInto6HBlock % 90
microQ = minutesInto90Block < 23 ? 1 : minutesInto90Block < 45 ? 2 : minutesInto90Block < 68 ? 3 : 4

pspPassesFilter   = passesFilter(pspFilt, yearlyQ, monthlyQ, weeklyQ, dailyQ, q90Q, microQ, inNYSession, inLDNSession, inAsiaSession, currentTFMinutes)
sdPassesFilter    = passesFilter(sdFilt, yearlyQ, monthlyQ, weeklyQ, dailyQ, q90Q, microQ, inNYSession, inLDNSession, inAsiaSession, currentTFMinutes)
smtfPassesFilter  = passesFilter(smtfFilt, yearlyQ, monthlyQ, weeklyQ, dailyQ, q90Q, microQ, inNYSession, inLDNSession, inAsiaSession, currentTFMinutes)


// ════════════════════════════════════════════════════════════════════════════════════
// SSMT CORE VARIABLES & TRUE ANCHOR QT TIME MATH
// ════════════════════════════════════════════════════════════════════════════════════
tf = timeframe.period

tf_sec     = timeframe.in_seconds(tf)
tf_ok_mic  = tf_sec <= 180
tf_ok      = tf_sec <= 900
tf_okD     = tf_sec <= 14400
tf_okW     = tf_sec <= 86400
tf_okMo    = tf_sec <= 525600
tf_okQ     = tf_sec <= 525600
tf_okY     = tf_sec <= 525600

msPerDay = 24*60*60*1000
ms90m   = 90*60*1000
msMicro = 1350000
msPerSec  = 1000
msPerMin  = 60000
msPerHour = 3600000

isLeapYear(int y) =>
    (y % 4 == 0 and y % 100 != 0) or (y % 400 == 0)

daysBeforeMonth(int m, int y) =>
    int leap = isLeapYear(y) ? 1 : 0
    int days = switch m
        1 => 0
        2 => 31
        3 => 59 + leap
        4 => 90 + leap
        5 => 120 + leap
        6 => 151 + leap
        7 => 181 + leap
        8 => 212 + leap
        9 => 243 + leap
        10 => 273 + leap
        11 => 304 + leap
        => 334 + leap 

getMsSinceMidnight(int t) =>
    hour(t, session_tz) * msPerHour + minute(t, session_tz) * msPerMin + second(t, session_tz) * msPerSec

toMidnight(int t) =>
    t - getMsSinceMidnight(t)

getFirstOfMonthTs(int t) =>
    int dom = dayofmonth(t, session_tz)
    toMidnight(t - (dom - 1) * msPerDay)

getFirstOfYearTs(int t) =>
    int y = year(t, session_tz)
    int m = month(t, session_tz)
    int d = dayofmonth(t, session_tz)
    int daysElapsed = daysBeforeMonth(m, y) + (d - 1)
    toMidnight(t - daysElapsed * msPerDay)

getWeeklyAnchor(int t) =>
    int dow = dayofweek(t, session_tz)
    int msSinceMid = getMsSinceMidnight(t)
    int dayStart_ = toMidnight(t)
    int daysBack = dow == 1 ? (msSinceMid < dayStartHour * msPerHour ? 7 : 0) : dow - 1
    dayStart_ - (daysBack * msPerDay) + (dayStartHour * msPerHour)

getTrueQTMonthlyAnchor(int t) =>
    int firstOfMonth = getFirstOfMonthTs(t)
    int dow = dayofweek(firstOfMonth, session_tz)
    int daysToAdd = dow == 1 ? 0 : dow == 2 ? -1 : 8 - dow
    firstOfMonth + daysToAdd * msPerDay + dayStartHour * msPerHour

int rawDayStart = toMidnight(time)
int anchorMs = dayStartHour * msPerHour
int msSinceMid = getMsSinceMidnight(time)
dayStart = msSinceMid >= anchorMs ? rawDayStart + anchorMs : rawDayStart + anchorMs - msPerDay
minsFromDayStart  = int(((time - dayStart) % msPerDay) / (60*1000))

int weekAnchor = getWeeklyAnchor(time)
val_sesW = int(math.max(1, math.min(4, int(math.floor((time - weekAnchor) / msPerDay)) + 1)))

qDay   = int(math.floor(minsFromDayStart/360))+1
minsIn6H = minsFromDayStart%360
val_sesD = qDay - 1

q90 = int(math.floor(minsIn6H/90))+1
val_ses = (qDay - 1) * 4 + (q90 - 1)

msInto90 = int((time-dayStart)%ms90m)
qMicro = math.max(1, math.min(4, int(math.floor(msInto90/msMicro))+1))
val_sesm = (qDay - 1) * 16 + (q90 - 1) * 4 + (qMicro - 1)

int monthAnchor = getTrueQTMonthlyAnchor(time)
int monthEnd = monthAnchor + 28 * msPerDay
int qDurMonth = (monthEnd - monthAnchor) / 4
val_sesMo = int(math.max(1, math.min(4, int(math.floor((time - monthAnchor) / qDurMonth)) + 1)))

int yearAnchor = getFirstOfYearTs(time)
int daysThisYear = isLeapYear(year(time, session_tz)) ? 366 : 365
int yearEnd = yearAnchor + daysThisYear * msPerDay
int qDurYear = (yearEnd - yearAnchor) / 4
val_sesY = int(math.max(1, math.min(4, int(math.floor((time - yearAnchor) / qDurYear)) + 1)))

daysInMonth(int m, int y) =>
    int days = switch m
        1 => 31
        2 => isLeapYear(y) ? 29 : 28
        3 => 31
        4 => 30
        5 => 31
        6 => 30
        7 => 31
        8 => 31
        9 => 30
        10 => 31
        11 => 30
        => 31 
    days

f_getQuarterlyBoundsStrict(int t) =>
    int y = year(t, session_tz)
    int m = month(t, session_tz)
    int startMonth = math.floor((m-1)/3)*3 + 1
    int pStart = toMidnight(getFirstOfMonthTs(t) - (daysBeforeMonth(m, y) - daysBeforeMonth(startMonth, y)) * msPerDay)
    int m1 = startMonth
    int m2 = startMonth + 1
    int m3 = startMonth + 2
    int y1 = y, int y2 = y, int y3 = y
    if m2 > 12
        m2 -= 12, y2 += 1
    if m3 > 12
        m3 -= 12, y3 += 1
    int daysInQ = daysInMonth(m1, y1) + daysInMonth(m2, y2) + daysInMonth(m3, y3)
    int pEnd = pStart + daysInQ * msPerDay
    [pStart, pEnd]

[qStart, qEnd] = f_getQuarterlyBoundsStrict(time)
int qDurQ = (qEnd - qStart) / 4
val_sesQ = int(math.max(1, math.min(4, int(math.floor((time - qStart) / qDurQ)) + 1)))

bool inActiveWeek = time < (getWeeklyAnchor(time) + 5 * msPerDay)
// --- NEW HELPER FUNCTION ---
f_get_cycle_id(string cyc) =>
    string c_id = ""
    if cyc == "Y"
        c_id := str.tostring(year(time, session_tz))
    else if cyc == "Q"
        c_id := str.tostring(year(time, session_tz)) + "_Q" + str.tostring(math.ceil(month(time, session_tz) / 3.0))
    else if cyc == "MoC"
        c_id := str.tostring(year(time, session_tz)) + "_" + str.tostring(month(time, session_tz))
    else if cyc == "W"
        c_id := str.tostring(getWeeklyAnchor(time)) 
    else if cyc == "D"
        c_id := str.tostring(toMidnight(time)) 
    else if cyc == "90m"
        int hour_block = int(math.floor(getMsSinceMidnight(time) / (6 * msPerHour)))
        c_id := str.tostring(toMidnight(time)) + "_" + str.tostring(hour_block)
    else if cyc == "Mi"
        int min90_block = int(math.floor(getMsSinceMidnight(time) / (90 * msPerMin)))
        c_id := str.tostring(toMidnight(time)) + "_" + str.tostring(min90_block)
    c_id
